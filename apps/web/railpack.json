{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        {
          "cmd": "sh -c 'cd ../server && bun install'",
          "customName": "Install dependencies (server)"
        },
        {
          "cmd": "sh -c 'cd ../web && bun install'",
          "customName": "Install dependencies (frontend)"
        }
      ]
    },
    "build": {
      "commands": ["bun run build"]
    }
  },
  "deploy": {
    "startCommand": "bun dist/index.js"
  }
}
